<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Zandu Retraite{% endblock %}</title>
    {% block stylesheets %}{% endblock %}
    {{ importmap('app') }}
</head>
<body>
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash flash-{{ label }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}

    {% block javascripts %}{% endblock %}
</body>
</html>
