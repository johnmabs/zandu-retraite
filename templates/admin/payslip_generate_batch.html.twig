{% extends 'layout/app.html.twig' %}
{% block title %}Génération de bulletins en lot
{% endblock %}
{% block content %}
	<div class="section-title">Générer des bulletins en lot</div>
	<div class="card">
		<form method="post">
			<input type="hidden" name="_csrf_token" value="{{ csrf_token('payslip-generate-batch') }}">
			<div class="form-group" style="max-width:320px;">
				<label for="sector">Secteur (laisser vide pour tous les membres actifs)</label>
				<select name="sector" id="sector">
					<option value="">-- Tous --</option>
					{% for sector in sectors %}
						<option value="{{ sector.id }}">{{ sector.name }}</option>
					{% endfor %}
				</select>
			</div>
			<div class="btn-row">
				<button type="submit" class="btn btn-gold">{{ icon('card') }}
					Générer</button>
			</div>
		</form>
	</div>
{% endblock %}
