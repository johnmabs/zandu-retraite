{% extends 'layout/app.html.twig' %}
{% block title %}Inscriptions en attente
{% endblock %}
{% block content %}
	<div class="section-title">Inscriptions en attente</div>

	<div class="card">
		{% if members is empty %}
			<div class="empty">{{ icon('file') }}<p>Aucune inscription en attente.</p>
			</div>
		{% else %}
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>N°</th>
							<th>Nom</th>
							<th>Téléphone</th>
							<th>Secteur</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						{% for member in members %}
							<tr>
								<td>{{ member.memberNumber }}</td>
								<td>{{ member.fullName }}</td>
								<td>{{ member.phone }}</td>
								<td>{{ member.sector.name }}</td>
								<td>
									<form method="post" action="{{ path('admin_member_approve', {id: member.id}) }}" style="display:inline">
										<input type="hidden" name="_csrf_token" value="{{ csrf_token('member-approve-' ~ member.id) }}">
										<button type="submit" class="btn btn-success btn-sm">Valider</button>
									</form>
									<form method="post" action="{{ path('admin_member_reject', {id: member.id}) }}" style="display:inline-flex;gap:6px;">
										<input type="hidden" name="_csrf_token" value="{{ csrf_token('member-reject-' ~ member.id) }}">
										<input type="text" name="reason" placeholder="Motif" style="width:110px;">
										<button type="submit" class="btn btn-danger btn-sm">Rejeter</button>
									</form>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}
	</div>
{% endblock %}
