{% extends 'layout/app.html.twig' %}
{% block title %}Gestion des clients
{% endblock %}
{% block content %}
	<div class="section-title">Clients</div>

	<div class="card">
		<form method="get" class="form-grid col3">
			<div class="form-group">
				<label for="q">Recherche</label>
				<input type="text" id="q" name="q" placeholder="Nom, numéro, téléphone..." value="{{ app.request.query.get('q') }}">
			</div>
			<div class="form-group">
				<label for="status">Statut</label>
				<select id="status" name="status">
					<option value="">-- Tous --</option>
					{% for status in statuses %}
						<option value="{{ status.value }}" {{ app.request.query.get('status') == status.value ? 'selected' }}>{{ status.value }}</option>
					{% endfor %}
				</select>
			</div>
			<div class="form-group">
				<label for="sector">Secteur</label>
				<select id="sector" name="sector">
					<option value="">-- Tous --</option>
					{% for sector in sectors %}
						<option value="{{ sector.id }}" {{ app.request.query.get('sector') == sector.id|string ? 'selected' }}>{{ sector.name }}</option>
					{% endfor %}
				</select>
			</div>
			<div class="form-group full">
				<button type="submit" class="btn btn-outline btn-sm">Filtrer</button>
			</div>
		</form>
	</div>

	<div class="card">
		{% if members.iterator|length == 0 %}
			<div class="empty">{{ icon('users') }}<p>Aucun client ne correspond à ces critères.</p>
			</div>
		{% else %}
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>N°</th>
							<th>Nom</th>
							<th>Téléphone</th>
							<th>Secteur</th>
							<th>Statut</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						{% for member in members %}
							<tr>
								<td>{{ member.memberNumber }}</td>
								<td>{{ member.fullName }}</td>
								<td>{{ member.phone }}</td>
								<td>{{ member.sector.name }}</td>
								<td>
									<span class="tag {{ member.status.value|tag_class }}">{{ member.status.value }}</span>
								</td>
								<td>
									<a href="{{ path('admin_member_detail', {id: member.id}) }}" class="btn btn-outline btn-sm">Voir</a>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}
	</div>
{% endblock %}
