{% extends 'base.html.twig' %}
{% block title %}{{ member.fullName }}{% endblock %}
{% block body %}
    <h1>{{ member.fullName }} — {{ member.memberNumber }}</h1>
    <p>Statut : {{ member.status.value }}</p>
    <p>Téléphone : {{ member.phone }}</p>
    <p>Secteur : {{ member.sector.name }}</p>
    <p>Versement journalier : {{ member.dailyPaymentAmount }} FCFA ({{ member.salaryCategory.value }})</p>

    <a href="{{ path('admin_payment_record_cash', {id: member.id}) }}">Encaisser un versement espèces</a>

    <h2>Versements</h2>
    <table>
        <thead><tr><th>Date</th><th>Montant</th><th>Moyen</th><th>Statut</th></tr></thead>
        <tbody>
        {% for payment in payments %}
            <tr>
                <td>{{ payment.paymentDate|date('d/m/Y') }}</td>
                <td>{{ payment.amount }} FCFA</td>
                <td>{{ payment.paymentMethod.value }}</td>
                <td>{{ payment.status.value }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
