{% extends 'base.html.twig' %}

{% block body %}
    {% set is_admin = app.user and 'ROLE_ADMIN' in app.user.roles %}

    <div class="header">
        <div class="logo">
            <svg viewBox="0 0 32 32" fill="none">
                <circle cx="16" cy="16" r="15" stroke="#C9A84C" stroke-width="1.5"/>
                <path d="M8 22 L16 8 L24 22" stroke="#C9A84C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M11 18 H21" stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="16" cy="8" r="2" fill="#C9A84C"/>
            </svg>
            Zandu Retraite
        </div>
        <div class="header-nav">
            <span class="nav-btn active">{{ is_admin ? 'Administration' : 'Espace Client' }}</span>
        </div>
        {% if app.user %}
            <div class="user-badge">
                <div class="avatar">{{ app.user.fullName|initials }}</div>
                <span>{{ app.user.fullName }}</span>
                <a href="{{ path(is_admin ? 'admin_logout' : 'member_logout') }}"
                   style="color:var(--text3);font-size:18px;padding:2px 4px;text-decoration:none;"
                   title="Déconnexion">⏏</a>
            </div>
        {% endif %}
    </div>

    <div class="app">
        {% block sidebar %}
            {% if is_admin %}
                {% include 'layout/_sidebar_admin.html.twig' %}
            {% else %}
                {% include 'layout/_sidebar_client.html.twig' %}
            {% endif %}
        {% endblock %}

        <div class="main">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="toast show flash-{{ label }}" style="position:static;display:flex;margin-bottom:12px;">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            {% block content %}{% endblock %}
        </div>
    </div>
{% endblock %}
