{% extends 'layout/app.html.twig' %}
{% block title %}Mes bulletins
{% endblock %}
{% block content %}
	<div class="section-title">Mes bulletins de paie</div>
	<div class="card">
		{% if payslips.iterator|length == 0 %}
			<div class="empty">{{ icon('card') }}<p>Aucun bulletin disponible pour l'instant.</p>
			</div>
		{% else %}
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>Numéro</th>
							<th>Période</th>
							<th>Net à percevoir</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						{% for payslip in payslips %}
							<tr>
								<td>{{ payslip.payslipNumber }}</td>
								<td>{{ payslip.periodStart|date('d/m/Y') }}
									–
									{{ payslip.periodEnd|date('d/m/Y') }}</td>
								<td>{{ payslip.netAmount }}
									FCFA</td>
								<td>
									<a href="{{ path('member_payslip_download', {id: payslip.id}) }}" class="btn btn-outline btn-sm">Télécharger</a>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}
	</div>
{% endblock %}
