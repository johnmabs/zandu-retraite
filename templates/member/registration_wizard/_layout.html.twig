{% extends 'base.html.twig' %}
{% block title %}Inscription
{% endblock %}
{% block body %}
	<div class="main" style="max-width:640px;margin:0 auto;">
		<div class="inscription-hero">
			<svg viewbox="0 0 32 32" fill="none" style="width:54px;height:54px;margin:0 auto 10px;display:block">
				<circle cx="16" cy="16" r="15" stroke="#C9A84C" stroke-width="1.5"/>
				<path d="M8 22 L16 8 L24 22" stroke="#C9A84C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
				<path d="M11 18 H21" stroke="#C9A84C" stroke-width="1.5" stroke-linecap="round"/>
				<circle cx="16" cy="8" r="2" fill="#C9A84C"/>
			</svg>
			<h1>Devenir adhérent Zandu Retraite</h1>
			<p>Quelques étapes pour créer votre compte d'épargne retraite</p>
		</div>

		<div class="steps">
			{% for n, label in {1: 'Identité', 2: 'Plan', 3: 'Paiement', 4: 'Confirmation'} %}
				<div class="step {{ n == current_step ? 'active' : (n < current_step ? 'done' : '') }}">
					<div class="step-num">{{ n < current_step ? '✓' : n }}</div>
					{{ label }}
				</div>
				{% if n < 4 %}
					<div class="step-line"></div>
				{% endif %}
			{% endfor %}
		</div>

		{% block step_content %}{% endblock %}
	</div>
{% endblock %}
