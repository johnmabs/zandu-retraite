{% extends 'member/registration_wizard/_layout.html.twig' %}
{% set current_step = 4 %}
{% block step_content %}
	<div class="card">
		<div class="section-title">Récapitulatif</div>
		<div class="form-grid">
			<div class="form-group">
				<label>Nom</label>
				<span>{{ step1.firstName }}
					{{ step1.lastName }}</span>
			</div>
			<div class="form-group">
				<label>Téléphone</label>
				<span>{{ step1.phone }}</span>
			</div>
			<div class="form-group">
				<label>Versement journalier</label>
				<span>{{ step2.dailyPaymentAmount }}
					FCFA</span>
			</div>
			<div class="form-group">
				<label>Durée</label>
				<span>{{ step2.engagementDuration.value }}
					ans</span>
			</div>
		</div>
	</div>

	<div class="card">
		<div class="section-title">Créez votre code d'accès</div>
		{{ form_start(form) }}
		{{ form_widget(form) }}
		<div class="btn-row">
			<a href="{{ path('member_registration_step3') }}" class="btn btn-outline btn-sm">← Retour</a>
			<button type="submit" class="btn btn-gold">Valider mon inscription</button>
		</div>
		{{ form_end(form) }}
	</div>
{% endblock %}
