{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
    <h1>Inscription</h1>

    {{ form_start(form) }}
        <div {{ stimulus_controller('sector-cascade', {
            subSectorsBySector: subSectorsBySector,
            otherSectorIds: otherSectorIds,
        }) }}>
            {{ form_row(form.firstName) }}
            {{ form_row(form.lastName) }}
            {{ form_row(form.gender) }}
            {{ form_row(form.birthDate) }}
            {{ form_row(form.phone) }}
            {{ form_row(form.whatsappPhone) }}
            {{ form_row(form.email) }}
            {{ form_row(form.idDocumentNumber) }}
            {{ form_row(form.profession) }}

            {{ form_row(form.sector) }}
            {{ form_row(form.subSector) }}
            {{ form_row(form.customSectorLabel) }}

            {{ form_row(form.homeAddress) }}
            {{ form_row(form.activityLocation) }}
            {{ form_row(form.beneficiary) }}

            {{ form_row(form.dailyPaymentAmount) }}
            {{ form_row(form.engagementDuration) }}
            {{ form_row(form.savingsGoal) }}
            {{ form_row(form.goalDetails) }}
        </div>

        {{ form_row(form.pin) }}

        <button type="submit">S'inscrire</button>
    {{ form_end(form) }}
{% endblock %}
