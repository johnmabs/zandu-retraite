{% extends 'base.html.twig' %}
{% block title %}Historique{% endblock %}
{% block body %}
    <h1>Historique des versements</h1>
    <table>
        <thead><tr><th>Date</th><th>Montant</th><th>Moyen</th><th>Statut</th></tr></thead>
        <tbody>
        {% for payment in payments %}
            <tr>
                <td>{{ payment.paymentDate|date('d/m/Y') }}</td>
                <td>{{ payment.amount }} FCFA</td>
                <td>{{ payment.paymentMethod.value }}</td>
                <td>{{ payment.status.value }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
