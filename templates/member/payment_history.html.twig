{% extends 'layout/app.html.twig' %}
{% block title %}Historique
{% endblock %}
{% block content %}
	<div class="section-title">Historique des versements</div>
	<div class="card">
		{% if payments.iterator|length == 0 %}
			<div class="empty">{{ icon('clock') }}<p>Aucun versement pour l'instant.</p>
			</div>
		{% else %}
			<div class="table-wrap">
				<table>
					<thead>
						<tr>
							<th>Date</th>
							<th>Montant</th>
							<th>Moyen</th>
							<th>Statut</th>
						</tr>
					</thead>
					<tbody>
						{% for payment in payments %}
							<tr>
								<td>{{ payment.paymentDate|date('d/m/Y') }}</td>
								<td>{{ payment.amount }}
									FCFA</td>
								<td>{{ payment.paymentMethod.value }}</td>
								<td>
									<span class="tag {{ payment.status.value|tag_class }}">{{ payment.status.value }}</span>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}
	</div>
{% endblock %}
